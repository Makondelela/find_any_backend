# Environment Variables for Elastic Beanstalk
# ===========================================
# These should be set in EB Console → Configuration → Software → Environment properties
# OR via AWS CLI: aws elasticbeanstalk update-environment --environment-name findfast-env --option-settings file://env-settings.json

option_settings:
  aws:elasticbeanstalk:application:environment:
    # Core Flask settings
    FLASK_ENV: production
    FLASK_SECRET_KEY: ""  # SET IN EB CONSOLE

    # Firebase settings
    FIREBASE_DATABASE_URL: ""  # SET IN EB CONSOLE (e.g., https://find-any-55a42-default-rtdb.firebaseio.com/)
    FIREBASE_CONFIG: ""        # SET IN EB CONSOLE (full service account JSON)
    FIREBASE_API_KEY: ""       # SET IN EB CONSOLE
    FIREBASE_MESSAGING_SENDER_ID: ""  # SET IN EB CONSOLE
    FIREBASE_APP_ID: ""        # SET IN EB CONSOLE

    # Google AI
    GOOGLE_API_KEY: ""         # SET IN EB CONSOLE

    # Admin
    ADMIN_EMAIL: ""            # SET IN EB CONSOLE
    PROFILE_ENCRYPTION_KEY: "" # SET IN EB CONSOLE (32-byte hex)

    # Remote scraping
    SCRAPE_API_KEY: ""         # SET IN EB CONSOLE (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")

# Example AWS CLI command to set all at once:
# aws elasticbeanstalk update-environment \
#   --environment-name findfast-env \
#   --option-settings \
#   Namespace=aws:elasticbeanstalk:application:environment,OptionName=FLASK_SECRET_KEY,Value=your-secret \
#   Namespace=aws:elasticbeanstalk:application:environment,OptionName=FIREBASE_DATABASE_URL,Value=https://your-project.firebaseio.com/ \
#   Namespace=aws:elasticbeanstalk:application:environment,OptionName=FIREBASE_CONFIG,Value='{"type":"service_account",...}' \
#   Namespace=aws:elasticbeanstalk:application:environment,OptionName=GOOGLE_API_KEY,Value=your-key \
#   Namespace=aws:elasticbeanstalk:application:environment,OptionName=FIREBASE_API_KEY,Value=your-key \
#   Namespace=aws:elasticbeanstalk:application:environment,OptionName=FIREBASE_MESSAGING_SENDER_ID,Value=your-id \
#   Namespace=aws:elasticbeanstalk:application:environment,OptionName=FIREBASE_APP_ID,Value=your-id \
#   Namespace=aws:elasticbeanstalk:application:environment,OptionName=ADMIN_EMAIL,Value=your@email.com \
#   Namespace=aws:elasticbeanstalk:application:environment,OptionName=SCRAPE_API_KEY,Value=your-api-key \
#   Namespace=aws:elasticbeanstalk:application:environment,OptionName=PROFILE_ENCRYPTION_KEY,Value=your-32-byte-hex