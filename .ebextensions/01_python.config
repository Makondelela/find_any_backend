# Elastic Beanstalk Python Configuration
# ======================================
# Configures the Python environment for Flask app

option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: app:app
    NumProcesses: 2
    NumThreads: 4

  aws:elasticbeanstalk:application:environment:
    # Flask configuration
    FLASK_ENV: production
    PYTHONPATH: /var/app/current

    # These will be overridden by EB environment variables
    # FLASK_SECRET_KEY: ""
    # FIREBASE_DATABASE_URL: ""
    # FIREBASE_CONFIG: ""
    # GOOGLE_API_KEY: ""
    # FIREBASE_API_KEY: ""
    # FIREBASE_MESSAGING_SENDER_ID: ""
    # FIREBASE_APP_ID: ""
    # ADMIN_EMAIL: ""
    # SCRAPE_API_KEY: ""
    # PROFILE_ENCRYPTION_KEY: ""

  aws:autoscaling:launchconfiguration:
    InstanceType: t3.medium
    SecurityGroups: sg-findfast  # Replace with your security group ID
    IamInstanceProfile: aws-elasticbeanstalk-ec2-role

  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx

  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: static

  aws:autoscaling:updatepolicy:rolling:
    RollingUpdateType: Health
    RollingUpdateEnabled: true
    MaxBatchSize: 1
    MinInstancesInService: 1
    PauseTime: PT10M

  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Unit: Percent
    UpperThreshold: 70
    LowerThreshold: 30
    Period: 5
    BreachDuration: 5